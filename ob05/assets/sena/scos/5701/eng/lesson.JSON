{"_data": [{"contents": [{"content": "Sally's On-The-Job Training", "type": "lesson_name"}, {"content": "Training the New Associate", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 17, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_1"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_4"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_5"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le17ob05re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Asking Somebody's Opinion", "type": "heading"}, {"content": "You can use the following phrases to ask somebody's opinion:<br><br>  What do you think about ... ? <br>  What's your opinion on ... ? <br>  Can I have your thoughts on ... ?<br>   What's your take on ... ?", "type": "describer"}, {"content": "<span class=\"strong\">Trainer</span>: What do you think about the magazine?<br><span class=\"strong\">Sally</span>: I love it. It's my favorite publication. ", "type": "example"}, {"content": "<span class=\"strong\">Trainer</span>: What's your opinion on the content?<br><span class=\"strong\">Sally</span>: I think it appeals to a wide audience and has a lot of very interesting articles.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Making and Responding to Requests", "type": "heading"}, {"content": "It's important to be polite when you ask for something or respond to requests. <br>You can make a request by using: <ul><li>Can you ... ?</li><li> Could you ... ?</li><li> Will you ... ? </li><li>Would you mind ... ? </li><li>Would it be possible to ... ?</li></ul>", "type": "describer"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Making Requests \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responding to Requests\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Could you remind me of your name? <br><br> Would it be possible to introduce me to some people in other departments?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Sure, here you are. <br><br>Yes, I'd love to!<br>That's a great idea.<br>I'm sorry, I can't do that right now.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "to show the ropes", "type": "name"}, {"content": " to explain how something works to somebody new ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My job is to show you the ropes in the company. ", "type": "example"}, {"content": "engenn5le17ob05aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use when you are in a training workshop.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to conduct ", "type": "name"}, {"content": "to run; to lead ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'll be conducting your training this morning. ", "type": "example"}, {"content": "engenn5le17ob05aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "onboarding workshop", "type": "name"}, {"content": "on-the-job training ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I hope this onboarding workshop will be useful for you. ", "type": "example"}, {"content": "engenn5le17ob05aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "first impression", "type": "name"}, {"content": "the opinion you have after the first time you see something ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  I hope I'll leave you with a great first impression of our company.", "type": "example"}, {"content": "engenn5le17ob05aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "associate", "type": "name"}, {"content": "a person you work with", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My job is to train you as a new associate.", "type": "example"}, {"content": "engenn5le17ob05aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "content", "type": "name"}, {"content": " the information found in a publication or online ", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: What's your opinion on the content?", "type": "example"}, {"content": "engenn5le17ob05aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Welcome the participants to the training session.", "type": "text"}, {"content": "Explain the purpose of the training session.", "type": "text"}, {"content": "One person makes a reasonable request. You accept.", "type": "text"}, {"content": "One person makes an unreasonable request. You do not accept.", "type": "text"}, {"content": "Practice the dialogue with a partner.", "type": "text"}, {"content": "Change roles.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a dialogue with 6 - 8 lines.", "type": "text"}, {"content": "I accept requests.", "type": "text"}, {"content": "I refuse requests.", "type": "text"}, {"content": "I practice the dialogue.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le17ob05re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le17ob05re2img01.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Trainer</span>: Hello. My name is Ted, and I'll be conducting your onboarding workshop this morning. Could you remind me of your name?<br>\n<span class=\"strong\">Sally</span>:  My name is Sally Davis.<br>\n<span class=\"strong\">Trainer</span>: Good morning, Sally. Welcome to the staff of <span class=\"italic\">Cambridge Life</span>! My job is to train you as a new associate. I'll show you the ropes in the company. We'll go over some of your new responsibilities. I hope I'll leave you with a great first impression of our company."}, {"image": "engenn5le17ob05re2img05.jpg", "time": "27500", "id": 2, "text": "<span class=\"strong\">Sally</span>:   I already have a good impression of <span class=\"italic\">Cambridge Life</span>.<br>\n<span class=\"strong\">Trainer</span>: What do you think about the magazine?<br>\n<span class=\"strong\">Sally</span>: I love it. It's my favorite publication.<br>\n<span class=\"strong\">Trainer</span>: What's your opinion on the content?"}, {"image": "engenn5le17ob05re2img05.jpg", "time": "37500", "id": 3, "text": "<span class=\"strong\">Sally</span>: I think it appeals to a wide audience and has a lot of very interesting articles.<br>\n<span class=\"strong\">Trainer</span>:  Excellent, I'm glad to hear it. Do you have any questions to start?<br>\n<span class=\"strong\">Sally</span>: Would it be possible to introduce me to some people in other departments?<br>\n<span class=\"strong\">Trainer</span>: Sure, that's a great idea. Come with me this way."}], "audiosrc": "engenn5le17ob05re2aud01", "coverimg": "engenn5le17ob05re2img01.jpg"}, "type": "slideshow"}], "id": 1}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [], "audiosrc": "engenn5le17ob05re6aud01", "coverimg": "engenn5le17ob05re6img01.jpg"}, "type": "picture"}], "id": 2}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": "  I can ask for somebody's opinion.", "type": "Learning Outcomes"}, {"content": "  I can make and respond to requests.", "type": "Learning Outcomes"}, {"content": " Do you think training is important when you start a new job? ", "type": "Free Header Item"}, {"content": " Why or why not? ", "type": "Free Header Item"}, {"content": " Who does the training?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"correct_feedback": "Correct", "incorrect_