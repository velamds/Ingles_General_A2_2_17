ple: Hello, client services, how can I help you?"}, {"type": "audio", "content": "engenn5le17ob03aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "department"}, {"type": "definition", "content": "a section of a company responsible for one area"}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": " Example: I'd like to speak to someone in the IT department."}, {"type": "audio", "content": "engenn5le17ob03aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to activate "}, {"type": "definition", "content": "to start; to get going "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Did you activate your account?"}, {"type": "audio", "content": "engenn5le17ob03aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "username "}, {"type": "definition", "content": "the letters, numbers or symbols you use to log in to a computer system"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": " Example: I see that the username sdavid is activated. "}, {"type": "audio", "content": "engenn5le17ob03aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "password "}, {"type": "definition", "content": "a secret combination of letters, numbers and symbols used to enter a computer system"}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": "Example: Sorry, I must have the wrong password. "}, {"type": "audio", "content": "engenn5le17ob03aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "network"}, {"type": "definition", "content": " a series of things that are connected, like the computers in a company's IT system"}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": " Example: I had problems logging on to the network"}, {"type": "audio", "content": "engenn5le17ob03aud07"}]}, {"type": "target_word", "contents": [{"type": "n